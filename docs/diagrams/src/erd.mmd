erDiagram
    users ||--o{ players : owns
    game_sessions ||--o{ players : seats
    game_sessions }o--|| levels : uses
    levels ||--o{ questions : contains
    questions ||--o{ choices : has
    questions ||--o{ answers : is answered by
    choices ||--o{ answers : selected by
    players ||--o{ answers : provides

    users {
        int user_id PK
        string school_id UK
        string full_name
        string email UK
        string role
        string password_hash
    }

    levels {
        int id PK
        int level_number
        string name
        int pass_score
        string picture
    }

    questions {
        int id PK
        int level_id FK
        string prompt
        string explanation
        int position
        int time_limit
        int base_points
    }

    choices {
        int id PK
        int question_id FK
        string choice_text
        boolean is_correct
    }

    game_sessions {
        int id PK
        string session_code UK
        int level_id FK
        datetime started_at
        datetime ended_at
        datetime question_started_at
        int current_position
    }

    players {
        int id PK
        int game_session_id FK
        int user_id FK
        string nickname
        int score
        boolean completed
    }

    answers {
        int id PK
        int player_id FK
        int question_id FK
        int choice_id FK
        boolean is_correct
        datetime answered_at
    }